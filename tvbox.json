        "15.1666",
        "15.2666"
      ]
    },
    {
      "name": "去广告·优质",
      "hosts": [
        "yzzy",
        "playback"
      ],
      "regex": [
        "16.63",
        "18.66",
        "17.66",
        "19.13"
      ]
    },
    {
      "name": "去广告·快看",
      "hosts": [
        "kuaikan",
        "vip.kuaikan"
      ],
      "regex": [
        "15.32",
        "15.231",
        "18.066"
      ]
    },
    {
      "name": "去广告·360",
      "hosts": [
        "lyhuicheng"
      ],
      "regex": [
        "#EXTINF.*?\\s+.*?hrz8QcR9.*?\\.ts\\s+",
        "#EXT-X-KEY:METHOD=NONE[\\s\\S]*?#EXT-X-DISCONTINUITY"
      ]
    }
